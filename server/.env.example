# Copy to .env and fill in real values. Never commit .env itself.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/feedback_collector?schema=public"
PORT=5000

# Signs session tokens. Use a long random string; anyone with this can forge logins.
JWT_SECRET="replace-with-a-long-random-string"

# Required on the signup form to create an ADMIN account.
ADMIN_SIGNUP_CODE="replace-with-your-own-code"
